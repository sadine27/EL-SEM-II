# ==============================================================================
# EL Pipeline — environment variables
# ==============================================================================
# Copy this file to `.env` (same directory) and fill in the values below.
# Never commit a real `.env` to git. The repo's `.gitignore` already excludes it.
#
# Each variable is marked [REQUIRED] or [OPTIONAL]:
#   - [REQUIRED]  pipeline crashes on startup if missing
#   - [OPTIONAL]  pipeline skips that capability gracefully if missing
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. YouTube Data API v3                                              [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/nodes/youtube_trending.py  (Phase 1 trending discovery)
# Get it:   https://console.cloud.google.com/apis/credentials
#           Enable "YouTube Data API v3" on the project, then create an API key.
YOUTUBE_API_KEY=""


# ------------------------------------------------------------------------------
# 2. Tavily Search API                                                [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/tavily.py, el/nodes/curate_picks.py, tavily_search_in_market.py
# Get it:   https://app.tavily.com/  →  Account → API Keys
TAVILY_API_KEY=""


# ------------------------------------------------------------------------------
# 3. Gemini via Vertex AI                                             [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/llm.py, el/nodes/gemini_extract_product.py, curator agent
# Auth:     OAuth via the service account in GOOGLE_SERVICE_ACCOUNT_JSON below.
#           No API key needed. The SA must have role `roles/aiplatform.user`
#           and the project must have Vertex AI API enabled.
# VERTEX_LOCATION: "global" (default) routes to the multi-region endpoint.
#           Override with a region (e.g. "us-central1") if you need
#           data-residency. Project ID is read from the SA JSON automatically.
VERTEX_LOCATION="global"

# Optional — only used by scripts/build_phase3_hil.py for the Telegram WebApp's
# in-browser Gemini call (which can't use Vertex's OAuth flow). Pipeline runs
# fine without this; just don't generate the HIL WebApp until you set it.
GEMINI_API_KEY=""


# ------------------------------------------------------------------------------
# 4. Google Service Account (Sheets + Drive)                          [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/google_sheets.py, el/google_drive.py
# Format:   the FULL service-account JSON, on a SINGLE line, in double quotes.
#           Inner double quotes inside the JSON must be escaped as \"
# Get it:   https://console.cloud.google.com/iam-admin/serviceaccounts
#           1. Create service account, download JSON key
#           2. Share the target Sheet doc + Drive folder with the SA email
#           3. Paste the entire JSON content as one line below
# Example:  GOOGLE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"...\",...}"
GOOGLE_SERVICE_ACCOUNT_JSON=""


# ------------------------------------------------------------------------------
# 5. CJ Dropshipping API                                              [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/cj.py, el/nodes/cj_get_token.py, cj_product_list.py
# Get it:   https://developers.cjdropshipping.com/  →  Sign in → API
#           CJ_EMAIL = the email you log into developers.cjdropshipping.com with
#           CJ_API_KEY = the API key shown in the developer portal
CJ_EMAIL=""
CJ_API_KEY=""


# ------------------------------------------------------------------------------
# 6. Supabase (database)                                              [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/supabase.py — every node that reads/writes private.* or public.*
# Get it:   https://supabase.com/dashboard/project/_/settings/api
#
# SUPABASE_URL          : "https://<project-ref>.supabase.co"
# Plus ONE of the keys below (provider tries them in this order):
#   SUPABASE_SERVICE_ROLE_KEY  — preferred (bypasses RLS, full read/write)
#   SUPABASE_SECRET_KEY        — fallback
#   SUPABASE_KEY               — final fallback (anon key — RLS-restricted)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# ------------------------------------------------------------------------------
# 7. Browserbase (headless browser)                                   [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/browserbase.py, el/nodes/browserbase_fetch.py (review extraction)
# Get it:   https://www.browserbase.com/  →  Settings → API Keys
BROWSERBASE_API_KEY=""


# ------------------------------------------------------------------------------
# 8. Telegram — Human-In-Loop bot                                     [REQUIRED]
# ------------------------------------------------------------------------------
# Used by:  el/telegram.py, el/nodes/prepare_telegram_card.py, callback handler
# This is the bot that posts curated cards and receives Approve/Reject taps.
#
# Get token: chat with @BotFather on Telegram → /newbot → copy the token
# Get chat_id:
#   1. Send any message to your new bot
#   2. Visit https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Copy the "chat":{"id":<NUMBER>} value
TELEGRAM_HIL_BOT_TOKEN=""
TELEGRAM_HIL_CHAT_ID=""


# ------------------------------------------------------------------------------
# 9. Telegram — Developer alert channel                               [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/error_handler.py, el/nodes/telegram_alert.py
# Separate bot+chat for error notifications. If missing, errors only go to logs.
# TELEGRAM_ALERT_CHAT_ID falls back to "8243518279" (n8n default) if blank.
EL_DEVELOPER_ALERT_TOKEN_KEY=""
EL_DEVELOPER_ALERT_CHAT_ID=""
TELEGRAM_ALERT_CHAT_ID=""


# ------------------------------------------------------------------------------
# 10. SP1 Telemetry / ε-greedy logging policy                         [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/nodes/stochastic_logger.py
# These control the stochastic HIL slate sampler that produces propensities
# for the Phase 3 paper's IPS analysis. Defaults are production-safe.

# Master kill switch. Set to "false" to revert to pre-SP1 deterministic phase4
# behavior with one config change. Default: "true".
EL_HIL_LOGGING_ENABLED="true"

# Exploration rate ε ∈ [0, 1]. ε=0 ⇒ deterministic phase4 (regression-equivalent).
# ε=1 ⇒ uniform random K-subset every batch. Default: 0.1.
EL_HIL_EPSILON="0.1"

# Optional integer seed for the slate sampler RNG. Leave unset in production
# (true random). Tests pass an explicit seed for reproducibility.
EL_HIL_LOGGING_RNG_SEED=""


# ------------------------------------------------------------------------------
# 11. SP2 Source Expansion                                            [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/sources/*, el/pipeline.py
# Controls which trend sources the pipeline loads at the start of each batch.
# Sources emit TrendCandidate objects into ctx["source_candidates"].

# Comma-separated list of source module names to enable. Known names:
#   youtube              — YouTube Trending IN (needs YOUTUBE_API_KEY)
#   shopify_competitor   — public /products.json on a Shopify-powered store
#   pytrends             — Google Trends IN daily/realtime + velocity (no key)
#   reddit               — India subreddits hot posts (needs REDDIT_* below)
#   newsapi              — India commerce headlines (needs NEWSAPI_KEY below)
#   amazon_in_movers     — Amazon IN Movers & Shakers scrape (no key)
#   rss_india            — Indian tech/commerce RSS network (no key)
#   google_news_india    — topic-segmented Google News IN RSS (no key)
# Unknown names are logged as warnings and skipped.
# Leave UNSET/empty to enable ALL shipped sources (the Fenix default) so nothing
# trending is missed — key-gated sources fail soft when their creds are absent.
EL_SOURCES_ENABLED=""

# Comma-separated list of Shopify store base URLs to crawl (no trailing slash
# required). Example:
#   EL_SHOPIFY_COMPETITOR_STORES="https://examplestore.com,https://other.myshopify.com"
# Empty value (default) makes the shopify_competitor source a no-op.
EL_SHOPIFY_COMPETITOR_STORES=""

# Maximum /products.json pages to fetch per store (each page = 250 products).
# Default: 4 → up to 1000 products per store per run.
EL_SHOPIFY_COMPETITOR_MAX_PAGES="4"

# Reddit source credentials (free app at reddit.com/prefs/apps). Without these,
# the reddit source skips silently.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="EL-TrendBot/2.0"

# NewsAPI key (free tier 100 req/day at newsapi.org). Without it the newsapi
# source skips silently.
NEWSAPI_KEY=""


# ------------------------------------------------------------------------------
# 11b. Fenix AI trend scoring (the "brain")                           [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/nodes/ai_score_trends.py
# After the keyword scorer ranks topics, Gemini re-scores/re-categorizes them
# with an open vocabulary so brand-new viral products (e.g. "Labubu") and event
# fan-merch (e.g. "RCB jersey" after an IPL win) are caught — not just keyword
# matches. Reuses GOOGLE_SERVICE_ACCOUNT_JSON / VERTEX_LOCATION (section 3).
# Fail-soft: with no service-account JSON, or on any error, the keyword scores
# are kept, so the engine still runs with zero AI cost.

# Master switch. "true" (default) enables AI scoring when Vertex creds exist.
EL_AI_SCORING_ENABLED="true"

# Hard cap on topics sent to the model per run (bounds cost). Default: 120.
EL_AI_SCORING_MAX_TOPICS="120"

# Topics per model call. Default: 40.
EL_AI_SCORING_BATCH="40"

# Model override. Default: gemini-2.5-flash.
EL_AI_SCORING_MODEL="gemini-2.5-flash"


# ------------------------------------------------------------------------------
# 12. SP3 Vision + pgvector                                           [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/embeddings.py, el/nodes/embed_candidate_products.py,
#           el/nodes/find_similar_products.py
# Controls Vertex AI multimodal embeddings for candidate products and the
# pgvector similarity index in private.product_embeddings. Each daily batch
# embeds at most ~3 products (the cj_top_3 picks). Worst-case spend is well
# under $0.02/day.

# Master kill switch. Set to "false" to disable embedding generation entirely
# (the embed_candidate_products node becomes a passthrough; zero Vertex spend).
# Default: "true".
EL_EMBEDDINGS_ENABLED="true"

# Override Vertex models. Leave defaults unless you need a different version.
EL_EMBEDDINGS_TEXT_MODEL="text-embedding-005"
EL_EMBEDDINGS_IMAGE_MODEL="multimodalembedding@001"

# Retry cap for Vertex 429/5xx responses (exponential backoff between attempts).
# Default: 3.
EL_EMBEDDINGS_MAX_RETRIES="3"


# ------------------------------------------------------------------------------
# 13. SP4 FastAPI Web App + Chat Bot                                  [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/web/*
# Controls the FastAPI web app exposing /api/runs, /api/chat (SSE), and HTMX
# pages. Disabled by default; pipeline-only deployments need none of these.

# Master kill switch. Set to "true" to enable the web app at boot time.
# Default: "false".
EL_WEB_ENABLED="false"

# Shared bearer token for all API requests (single-operator MVP). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when EL_WEB_ENABLED=true; app refuses to start without it.
WEB_SECRET_KEY=""

# In-memory per-IP rate limit (token-bucket capacity per minute).
# Default: 30.
WEB_RATE_LIMIT_PER_MINUTE="30"

# Number of pgvector-retrieved products to ground each chat answer in.
# Default: 5.
WEB_CHAT_TOP_K="5"

# Vertex Gemini model used by the chat bot. Default: gemini-2.0-flash.
WEB_LLM_MODEL="gemini-2.0-flash"


# ------------------------------------------------------------------------------
# 14. SP5a Outbound Email + Business Notification                     [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/email.py, el/nodes/email_digest.py, email_product_detail.py,
#           notify_business.py
# Sends an end-of-run digest (with optional XLSX of the curated-picks Sheet),
# one detail email per approved pick, and a short Telegram ping to the business
# owner. All three nodes skip cleanly if their respective env vars are missing.
#
# Gmail SMTP requires an APP PASSWORD (not your account password):
#   https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
GMAIL_SMTP_FROM_NAME="EL Bot"

# Optional override of recipient address (defaults to GMAIL_SMTP_USER).
BUSINESS_NOTIFY_EMAIL=""

# Telegram chat to ping after each run. Falls back to TELEGRAM_ALERT_CHAT_ID.
BUSINESS_NOTIFY_TELEGRAM_CHAT_ID=""

# Base URL used to build the chat-link in the notify_business message.
CHAT_BASE_URL="https://el.local/chat"

# Optional: a specific Google Sheet ID to export as XLSX and attach to the
# digest. If unset, the digest sends without an attachment.
EL_DIGEST_SHEET_ID=""


# ------------------------------------------------------------------------------
# 15. SP5b Shopify auto-store                                         [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/shopify.py, el/nodes/generate_shopify_theme.py,
#           upload_shopify_theme.py, upload_shopify_products.py
# Pushes the LLM-generated theme snippet + approved products to a configured
# Shopify dev store. All three nodes skip cleanly when the two creds are unset.
#
# Get it:   https://partners.shopify.com/  →  Stores → Add store (development)
#           Then in the store: Settings → Apps → Develop apps → create app →
#           give it `write_products` + `write_themes` scopes → Install →
#           reveal the Admin API access token.
SHOPIFY_STORE_DOMAIN=""         # e.g. "mystore.myshopify.com" (no protocol)
SHOPIFY_API_VERSION="2024-10"   # rarely changed

# Option A — Admin API access token (custom app → Install → reveal token)
SHOPIFY_ADMIN_API_TOKEN=""

# Option B — OAuth client credentials (Partners app → API key + secret)
# el/shopify.py uses B automatically when SHOPIFY_ADMIN_API_TOKEN is blank.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""


# ------------------------------------------------------------------------------
# 16. SP6 CRM minimal                                                 [OPTIONAL]
# ------------------------------------------------------------------------------
# SP6 uses the existing Supabase credentials (section 6) — no new vars needed.
# Tables created by migrations/combined_apply_all.sql:
#   private.suppliers, private.disputes, private.niche_performance
# Dashboard available at /crm once the migration is applied and the private
# schema is exposed in Supabase API settings.


# ------------------------------------------------------------------------------
# 17. SP8 Docker worker                                               [OPTIONAL]
# ------------------------------------------------------------------------------
# Used by:  el/worker.py
# How often the worker polls private.run_requests for new queued jobs.
# Default: 30 seconds. Lower values increase Supabase API call frequency.
EL_WORKER_POLL_SECONDS="30"
