# Environment variables (never commit)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local pipeline output & logs
output/
*.log

# LaTeX build artifacts (paper/main.pdf is committed; intermediate files are not)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Tool caches / IDE
graphify-out/
.claude/
.gemini/
.aider*

# GUI build artifacts (PyInstaller)
dist/
build/
*.spec

# OS generated
.DS_Store
Thumbs.db

# Local-only notes (Claude memory) — kept on disk, not committed
memory/

# Windows system cache files accidentally swept in by a broad `git add`
%SystemDrive%/
*.ver0x*.db
