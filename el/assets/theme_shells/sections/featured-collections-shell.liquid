{{ 'tokens.css' | asset_url | stylesheet_tag }}

<section class="el-shell el-featured-collections" aria-labelledby="el-featured-heading">
  <div class="el-shell__inner">
    <h2 id="el-featured-heading">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.subhead | escape }}</p>
    <ul class="el-collection-list" role="list">
      <li><a href="/collections/{{ section.settings.collection_1_handle | escape }}">{{ section.settings.collection_1_title | escape }}</a></li>
      <li><a href="/collections/{{ section.settings.collection_2_handle | escape }}">{{ section.settings.collection_2_title | escape }}</a></li>
      <li><a href="/collections/{{ section.settings.collection_3_handle | escape }}">{{ section.settings.collection_3_title | escape }}</a></li>
    </ul>
  </div>
</section>

<style>
  .el-shell {
    background: var(--el-surface);
    color: var(--el-text);
    font-family: var(--el-font-body);
    padding: 3rem 1.5rem;
  }
  .el-shell__inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .el-shell h2 {
    color: var(--el-primary);
    font-family: var(--el-font-heading);
    margin: 0 0 0.75rem;
  }
  .el-shell p {
    color: var(--el-muted);
  }
  .el-collection-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .el-collection-list a {
    background: var(--el-bg);
    border: 1px solid var(--el-secondary);
    border-radius: var(--el-radius);
    color: var(--el-text);
    display: block;
    padding: 1rem;
    text-decoration: none;
  }
</style>

{% schema %}
{
  "name": "EL Featured Collections Shell",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subhead", "label": "Subhead" },
    { "type": "text", "id": "collection_1_title", "label": "Collection 1 title" },
    { "type": "collection", "id": "collection_1_handle", "label": "Collection 1" },
    { "type": "text", "id": "collection_2_title", "label": "Collection 2 title" },
    { "type": "collection", "id": "collection_2_handle", "label": "Collection 2" },
    { "type": "text", "id": "collection_3_title", "label": "Collection 3 title" },
    { "type": "collection", "id": "collection_3_handle", "label": "Collection 3" }
  ],
  "presets": [{ "name": "EL Featured Collections Shell" }]
}
{% endschema %}
