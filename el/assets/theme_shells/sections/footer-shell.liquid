{{ 'tokens.css' | asset_url | stylesheet_tag }}

<footer class="el-shell el-footer" aria-labelledby="el-footer-heading">
  <div class="el-shell__inner">
    <h2 id="el-footer-heading">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.body | escape }}</p>
    <nav aria-label="Footer">
      <ul class="el-footer-links" role="list">
        <li><a href="{{ section.settings.link_1_url | escape }}">{{ section.settings.link_1_label | escape }}</a></li>
        <li><a href="{{ section.settings.link_2_url | escape }}">{{ section.settings.link_2_label | escape }}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .el-shell {
    background: var(--el-text);
    color: var(--el-bg);
    font-family: var(--el-font-body);
    padding: 2.5rem 1.5rem;
  }
  .el-shell__inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .el-shell h2 {
    color: var(--el-bg);
    font-family: var(--el-font-heading);
    margin: 0 0 0.75rem;
  }
  .el-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .el-footer-links a {
    color: var(--el-bg);
  }
</style>

{% schema %}
{
  "name": "EL Footer Shell",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "link_1_label", "label": "Link 1 label" },
    { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "link_2_label", "label": "Link 2 label" },
    { "type": "url", "id": "link_2_url", "label": "Link 2 URL" }
  ],
  "presets": [{ "name": "EL Footer Shell" }]
}
{% endschema %}
