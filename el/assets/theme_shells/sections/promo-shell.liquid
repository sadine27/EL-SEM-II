{{ 'tokens.css' | asset_url | stylesheet_tag }}

<section class="el-shell el-promo" aria-labelledby="el-promo-heading">
  <div class="el-shell__inner">
    <p class="el-shell__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="el-promo-heading">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.body | escape }}</p>
    <a class="el-shell__button" href="{{ section.settings.cta_link | escape }}">
      {{ section.settings.cta_label | escape }}
    </a>
  </div>
</section>

<style>
  .el-shell {
    background: var(--el-primary);
    color: var(--el-bg);
    font-family: var(--el-font-body);
    padding: 3rem 1.5rem;
  }
  .el-shell__inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .el-shell h2 {
    color: var(--el-bg);
    font-family: var(--el-font-heading);
    margin: 0 0 0.75rem;
  }
  .el-shell p {
    max-width: 42rem;
  }
  .el-shell__eyebrow {
    color: var(--el-accent);
    font-weight: 700;
  }
  .el-shell__button {
    background: var(--el-bg);
    border-radius: var(--el-radius);
    color: var(--el-primary);
    display: inline-block;
    margin-top: 1rem;
    padding: 0.85rem 1.2rem;
    text-decoration: none;
  }
</style>

{% schema %}
{
  "name": "EL Promo Shell",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "EL Promo Shell" }]
}
{% endschema %}
