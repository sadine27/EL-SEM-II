{{ 'tokens.css' | asset_url | stylesheet_tag }}

{% assign el_collection = collections[section.settings.collection_handle] %}

<section class="el-shell el-product-grid" aria-labelledby="el-product-grid-heading">
  <div class="el-shell__inner">
    <h2 id="el-product-grid-heading">{{ section.settings.heading | escape }}</h2>
    <p class="el-grid__subhead">{{ section.settings.subhead | escape }}</p>
    {% if el_collection and el_collection.products_count > 0 %}
      <ul class="el-product-list" role="list">
        {% for product in el_collection.products limit: section.settings.product_limit %}
          <li class="el-card">
            <a class="el-card__link" href="{{ product.url | escape }}">
              <div class="el-card__media">
                {% if product.featured_image %}
                  <img
                    class="el-card__img"
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="600" height="600">
                {% else %}
                  <div class="el-card__img el-card__img--placeholder" aria-hidden="true"></div>
                {% endif %}
                {% if section.settings.show_badge %}
                  <span class="el-card__badge">{{ section.settings.badge_label | escape }}</span>
                {% endif %}
              </div>
              <div class="el-card__body">
                <span class="el-card__title">{{ product.title | escape }}</span>
                <span class="el-card__price">{{ product.price | money }}</span>
              </div>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>No products are available yet.</p>
    {% endif %}
  </div>
</section>

<style>
  .el-shell {
    background: var(--el-bg);
    color: var(--el-text);
    font-family: var(--el-font-body);
    padding: 3.5rem 1.5rem;
  }
  .el-shell__inner { max-width: 75rem; margin: 0 auto; }
  .el-shell h2 {
    color: var(--el-primary);
    font-family: var(--el-font-heading);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0 0 0.5rem;
  }
  .el-grid__subhead { color: var(--el-muted); margin: 0 0 2rem; }

  .el-product-list {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .el-card {
    background: #fff;
    border-radius: calc(var(--el-radius) * 1.5);
    box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.06);
    overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .el-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 8px rgba(0,0,0,.08), 0 16px 40px rgba(0,0,0,.12);
  }
  .el-card__link { color: var(--el-text); text-decoration: none; display: block; }

  .el-card__media { position: relative; aspect-ratio: 1 / 1; background: #f4f4f5; }
  .el-card__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .el-card__img--placeholder {
    background: linear-gradient(135deg, var(--el-secondary), var(--el-bg));
  }
  .el-card__badge {
    position: absolute; top: .75rem; left: .75rem;
    background: var(--el-accent); color: #fff;
    font-size: .7rem; font-weight: 700; letter-spacing: .03em;
    text-transform: uppercase;
    padding: .3rem .6rem; border-radius: 999px;
  }

  .el-card__body { padding: 1rem 1rem 1.25rem; display: grid; gap: .4rem; }
  .el-card__title {
    font-weight: 600; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .el-card__price { color: var(--el-primary); font-weight: 700; font-size: 1.05rem; }
</style>

{% schema %}
{
  "name": "EL Product Grid Shell",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subhead", "label": "Subhead" },
    { "type": "collection", "id": "collection_handle", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Product limit", "min": 1, "max": 24, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_badge", "label": "Show trending badge", "default": true },
    { "type": "text", "id": "badge_label", "label": "Badge label", "default": "Trending" }
  ],
  "presets": [{ "name": "EL Product Grid Shell" }]
}
{% endschema %}
